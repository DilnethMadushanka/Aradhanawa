{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://aradhanawa-e52be.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://aradhanawa-e52be.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/",
      "destination": "/"
    }
  ]
}
